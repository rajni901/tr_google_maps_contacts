<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_google_maps" model="ir.ui.view">
        <field name="name">res.partner.form.google.maps</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Location Map" name="google_map_page">
                    <div class="tr-google-map-container">
                        <widget name="tr_google_map"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
